*&---------------------------------------------------------------------*
*& Report  ZATC_RECHECK_{{batch_id}}
*&---------------------------------------------------------------------*
*& Generated by ntt-atc-batch-remediator. Verifies ATC findings after
*& a patch batch is imported. Run interactively in SE38; output file
*& path is selected on the selection screen.
*&---------------------------------------------------------------------*
REPORT zatc_recheck_{{batch_id}}.

PARAMETERS p_outf TYPE string LOWER CASE DEFAULT '/tmp/zatc_recheck_{{batch_id}}.xml'.
PARAMETERS p_var  TYPE c LENGTH 30        DEFAULT 'S4HANA_READINESS_2025'.

DATA lt_objects TYPE STANDARD TABLE OF satc_ci_obj WITH EMPTY KEY.

START-OF-SELECTION.
  PERFORM build_object_list.
  PERFORM run_atc.

FORM build_object_list.
{{object_list_lines}}
ENDFORM.

FORM run_atc.
  DATA lt_out TYPE STANDARD TABLE OF satc_ci_finding WITH EMPTY KEY.
  DATA lv_xml TYPE xstring.
  TRY.
      cl_satc_ci_api_pu=>run(
        EXPORTING variant_name = p_var
                  objects      = lt_objects
        IMPORTING findings     = lt_out ).
    CATCH cx_root INTO DATA(lx).
      MESSAGE lx->get_text( ) TYPE 'E'.
  ENDTRY.
  CALL TRANSFORMATION id SOURCE findings = lt_out RESULT XML lv_xml.
  OPEN DATASET p_outf FOR OUTPUT IN BINARY MODE.
  TRANSFER lv_xml TO p_outf.
  CLOSE DATASET p_outf.
  WRITE: / 'ATC recheck for batch {{batch_id}} done. Output:', p_outf.
ENDFORM.
