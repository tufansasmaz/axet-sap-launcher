    "/intelligence/api/knowledge-models/{km_id}/records/{record_id}/data": {
      "get": {
        "operationId": "getRecordData",
        "summary": "Get Record Data",
        "description": "Query data rows from a record with optional KPI computation. FIELD FORMAT: fields parameter must use field names WITHOUT record prefix — no dots allowed. Correct: CASE_ID,VENDOR,AMOUNT. Wrong: AP_EVENT_LOG.CASE_ID. KPI VALUES: To get computed KPI values per row, pass KPI IDs in the kpis parameter. KPI IDs come from listKMKPIs. The response will include KPI values as extra columns alongside field values. PAGINATION: Use limit and offset to control how many rows are returned. SEGMENT ANALYSIS: To get KPI values grouped by a dimension (e.g. per vendor), set fields to the grouping dimension and kpis to the desired metrics.",
        "parameters": [
          {"name": "km_id", "in": "path", "required": true, "type": "string", "description": "Knowledge Model ID"},
          {"name": "record_id", "in": "path", "required": true, "type": "string", "description": "Record ID"},
          {"name": "fields", "in": "query", "required": true, "type": "string", "description": "REQUIRED. Comma-separated field IDs WITHOUT record prefix. Example: CASE_ID,VENDOR,AMOUNT. NEVER use dots or prefixes like TABLE_NAME.FIELD."},
          {"name": "kpis", "in": "query", "required": false, "type": "string", "description": "Comma-separated KPI IDs from listKMKPIs. When provided, KPI values are computed and returned as additional columns in the response data. Use this to get actual metric values. Example: kpis=on_time_payment_rate,invoice_block_rate. For segment analysis, combine with a dimension field: fields=VENDOR&kpis=invoice_block_rate returns block rate per vendor."},
          {"name": "limit", "in": "query", "required": false, "type": "integer", "default": 1000, "description": "Maximum number of rows to return. Default 1000. Use higher values for full dataset retrieval or lower values for sampling."},
          {"name": "offset", "in": "query", "required": false, "type": "integer", "default": 0, "description": "Number of rows to skip for pagination. Use with limit to page through large datasets. Example: offset=1000&limit=1000 returns rows 1001-2000."},
          {"name": "sorting", "in": "query", "required": false, "type": "string", "description": "Sort order. Format: FIELD_ID:ASC or FIELD_ID:DESC. Example: TIMESTAMP:DESC"}
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "page": {"type": "integer"},
                "pageSize": {"type": "integer"},
                "total": {"type": "integer"},
                "sort": {"type": "array", "items": {"type": "string"}},
                "content": {
                  "type": "object",
                  "properties": {
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "name": {"type": "string"},
                          "type": {"type": "string"},
                          "format": {"type": "string"},
                          "unit": {"type": "string"},
                          "aggregation": {"type": "boolean"},
                          "filterable": {"type": "boolean"},
                          "sortable": {"type": "boolean"}
                        }
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {"type": "object"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
